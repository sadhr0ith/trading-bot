# Binance API credentials (required for Binance data source)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Gmail credentials (required for email notifications)
# GMAIL_SENDER_EMAIL: Your Gmail address (e.g., yourname@gmail.com)
# GMAIL_APP_PASSWORD: Generate from Google Account → Security → 2-Step Verification → App Passwords
GMAIL_SENDER_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Optional SMTP override (defaults: smtp.gmail.com:587)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Email notification recipients (comma-separated)
NOTIFICATION_EMAILS=user1@example.com,user2@example.com
# Optional: override default logger level (DEBUG, INFO, WARNING, ERROR)
TRADING_BOT_LOG_LEVEL=INFO

# Optional: cache TTL (seconds) for fetched market data; 0 disables caching
TRADING_BOT_CACHE_TTL_SECONDS=3600
